# Split v2 embedding profile. No consumer-specific settings.
MEMORYLAYER_EMBED_REQUIRE_ALL_MODELS=true
MEMORYLAYER_EMBED_PARALLEL_STARTUP=true
MEMORYLAYER_EMBED_BOUNDED_PROFILE=1
MEMORYLAYER_EMBED_SINGLE_VECTOR_PROVIDER=vllm_sparkrun
MEMORYLAYER_EMBED_MULTI_VECTOR_PROVIDER=vllm_subprocess
MEMORYLAYER_EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-2B
MEMORYLAYER_EMBEDDING_DIMENSIONS=1920
MEMORYLAYER_EMBEDDING_SPARKRUN_RECIPE=/opt/memorylayer/recipes/single.yaml
MEMORYLAYER_EMBEDDING_SPARKRUN_REUSE=false
MEMORYLAYER_EMBEDDING_VLLM_GPU_MEM_UTIL=0.32
MEMORYLAYER_EMBEDDING_VLLM_MAX_LENGTH=8192
MEMORYLAYER_EMBEDDING_VLLM_DTYPE=bfloat16
MEMORYLAYER_EMBEDDING_VLLM_ENFORCE_EAGER=true
MEMORYLAYER_EMBEDDING_VLLM_MAX_CONCURRENT=32
MEMORYLAYER_EMBEDDING_VLLM_OVERSUBSCRIBE=1
MEMORYLAYER_EMBEDDING_COLPALI_MODEL=ModernVBERT/colmodernvbert-merged
MEMORYLAYER_EMBEDDING_COLPALI_POOL_FACTOR=1
MEMORYLAYER_EMBED_MV_SPARKRUN_RECIPE=/opt/memorylayer/recipes/multi.yaml
MEMORYLAYER_EMBEDDING_VLLM_MV_GPU_MEM_UTIL=0.10
MEMORYLAYER_EMBEDDING_VLLM_MV_MAX_LENGTH=4096
MEMORYLAYER_EMBEDDING_VLLM_MV_MAX_CONCURRENT=16
MEMORYLAYER_EMBEDDING_VLLM_MV_OVERSUBSCRIBE=1
MEMORYLAYER_EMBED_TRANSCRIPTION_ENABLED=false
MEMORYLAYER_EMBED_UNLIMITED_OCR_ENABLED=false
MEMORYLAYER_EMBED_UNLIMITED_OCR_MODEL=baidu/Unlimited-OCR
MEMORYLAYER_EMBED_UNLIMITED_OCR_MAX_TOKENS=4096
MEMORYLAYER_EMBED_UNLIMITED_OCR_VLLM_GPU_MEM_UTIL=0.40
MEMORYLAYER_EMBED_UNLIMITED_OCR_VLLM_MAX_CONCURRENT=1
MEMORYLAYER_EMBED_UNLIMITED_OCR_VLLM_OVERSUBSCRIBE=1
MEMORYLAYER_EMBED_GLM_OCR_ENABLED=false
MEMORYLAYER_EMBED_DEEPSEEK_OCR_ENABLED=false
MEMORYLAYER_EMBED_GEMINI_ENABLED=false
MEMORYLAYER_EMBED_LLM_ENABLED=false
MEMORYLAYER_EMBED_GLINER2_ENABLED=true
MEMORYLAYER_EMBED_VISUAL_TOKENIZER_ENABLED=false
EMBED_SERVER_RUN_SIDECAR=false
HF_HOME=/cache/huggingface
HF_HUB_CACHE=/cache/huggingface/hub
MEMORYLAYER_EMBED_PROFILE=embedding
MEMORYLAYER_EMBED_MAX_CONCURRENT=32
MEMORYLAYER_EMBED_MAX_QUEUED=64
MEMORYLAYER_EMBED_QUEUE_TIMEOUT=120
MEMORYLAYER_EMBED_GLINER2_WORKER_PYTHON=/opt/memorylayer/venvs/ner/bin/python
MEMORYLAYER_EMBED_GLINER2_WORKER_SCRIPT=/opt/memorylayer/ner_worker.py
MEMORYLAYER_EMBED_GLINER2_DEVICE=cuda
