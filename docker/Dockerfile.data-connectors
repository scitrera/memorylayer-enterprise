# syntax=docker/dockerfile:1
# Repository-root context. Installs the public Aether and rt-data packages.
FROM python:3.12-slim-bookworm@sha256:782412e85d0f0984994c290652577d4018aff08145c85b262bb63dc0c7522254

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential ca-certificates curl && \
    rm -rf /var/lib/apt/lists/*
RUN groupadd --gid 1000 dataconn && \
    useradd --uid 1000 --gid dataconn --create-home dataconn

WORKDIR /app
COPY memorylayer-data-connectors /src/memorylayer-data-connectors
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install /src/memorylayer-data-connectors && pip check
RUN python -c 'from scitrera_aether_client.proto import aether_pb2; assert {"checked_access", "access_receipt"} <= {f.name for f in aether_pb2.ProxyHttpRequest.DESCRIPTOR.fields}'

# Alembic is discovered from the installed package's db/migrations directory.
COPY LICENSE NOTICE THIRD_PARTY_NOTICES.md /usr/share/licenses/memorylayer/
RUN pip inspect > /usr/share/licenses/memorylayer/python-dependencies.json && \
    apt-get purge -y build-essential && apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/* /src

LABEL org.opencontainers.image.licenses="AGPL-3.0-only"
LABEL org.opencontainers.image.source="https://github.com/scitrera/memorylayer-enterprise"
USER dataconn
EXPOSE 8100
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8100/healthz || exit 1
ENTRYPOINT ["data-connectors"]
