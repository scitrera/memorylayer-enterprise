# syntax=docker/dockerfile:1
# Repository-root context. Uses public dependencies; no sibling checkouts.
FROM python:3.12-slim-bookworm@sha256:782412e85d0f0984994c290652577d4018aff08145c85b262bb63dc0c7522254

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MALLOC_ARENA_MAX=2

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential git ca-certificates curl poppler-utils \
        libreoffice-writer libreoffice-calc libreoffice-impress \
        fonts-dejavu fonts-liberation && \
    rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 1000 memorylayer && \
    useradd --uid 1000 --gid memorylayer --create-home memorylayer

WORKDIR /app
COPY memorylayer-enterprise /src/memorylayer-enterprise
COPY oss-source.toml /src/oss-source.toml
COPY scripts/dev.py /src/scripts/dev.py
# Empty uses the reviewed commit in oss-source.toml. Development builds can
# pass a branch/tag; publishing workflows never supply this override.
ARG MEMORYLAYER_OSS_REF=
RUN --mount=type=cache,target=/root/.cache/pip \
    python /src/scripts/dev.py enterprise --python /usr/local/bin/python \
        --no-dev --non-editable \
        --record /usr/share/licenses/memorylayer/oss-source.json
# The separately released Apache-2.0 storage client is distributed through Git.
ARG BLOBGW_CLIENT_REF=clients/python/v0.7.1
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install \
        "blobgw-client @ git+https://github.com/scitrera/memorylayer-storage.git@${BLOBGW_CLIENT_REF}#subdirectory=clients/python" && \
    pip check

# Refuse an SDK incapable of carrying checked VFS authorization receipts.
RUN python -c 'from scitrera_aether_client.proto import aether_pb2; assert hasattr(aether_pb2, "ResourceAccessRequest"); assert {"checked_access", "access_receipt"} <= {f.name for f in aether_pb2.ProxyHttpRequest.DESCRIPTOR.fields}'

COPY LICENSE NOTICE THIRD_PARTY_NOTICES.md /usr/share/licenses/memorylayer/
RUN pip inspect > /usr/share/licenses/memorylayer/python-dependencies.json && \
    apt-get purge -y build-essential git && apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/* /src

# Runtime startup and the worker share the same versioned migration source.
COPY memorylayer-enterprise/migrations /app/migrations
COPY memorylayer-enterprise/alembic.ini /app/alembic.ini
ENV MEMORYLAYER_ALEMBIC_DIR=/app/migrations \
    MEMORYLAYER_ALEMBIC_CONFIG=/app/alembic.ini

LABEL org.opencontainers.image.licenses="AGPL-3.0-only"
LABEL org.opencontainers.image.source="https://github.com/scitrera/memorylayer-enterprise"
USER memorylayer
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1
ENTRYPOINT ["memorylayer-enterprise"]
CMD ["serve", "--host", "0.0.0.0", "--port", "8000"]
